# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (Supabase Postgres – use the pooler URL in production) ────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ─── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Admin seed account (used by scripts/seed-admin.js) ────────────────────────
ADMIN_EMAIL=admin@daftar.app
ADMIN_PASSWORD=change-me

# ─── AI Providers (Step 1.2) ────────────────────────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=

# Vision model for image reading (Phase 3 – images).
# Groq (fast): VISION_PROVIDER=groq with GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Google (slower free tier): VISION_PROVIDER=gemini with VISION_MODEL=gemini-3.7-flash
# VISION_PROVIDER=groq
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# VISION_MODEL=gemini-3.7-flash

# Provider selectors – change only if you add a new implementation
STT_PROVIDER=gemini
REVIEWER_PROVIDER=gemini
LLM_PROVIDER=groq

# Agent reasoning effort for GPT-OSS models: low = أسرع (تفكير أقصر), medium/high = أعمق وأبطأ.
# أي قيمة تانية (أو فاضي) = بدون إرسال الباراميتر. الافتراضي في الكود: low.
# LLM_REASONING_EFFORT=low

# STT model for Gemini transcription (free tier, Egyptian Arabic).
# STT_MODEL=gemini-3.5-flash-lite

# Optional: override the Egyptian-Arabic hint prompt (Whisper) / hint words (Gemini STT).
# The built-in default already covers dialect numbers/currency/daily life.
# WHISPER_PROMPT=

# Debug STT: يطبع التفريغ الخام/بعد القواعد/النهائي وقائمة الإصلاحات في اللوج (نصوص فقط، لا صوت).
# DEBUG_STT=true

# ─── Web Push / VAPID (added in Step 1.5) ──────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@daftar.app

# ─── Phase 2.1 – public signup & manual activation ──────────────────────────────
# WhatsApp number (international format, no +) for the "Request subscription" button.
# The button is hidden in the app when unset.
# WHATSAPP_NUMBER=2010xxxxxxx

# ─── Phase 2.4 – encrypted backups ─────────────────────────────────────────────
# Strong secret for AES-256-GCM backup encryption. Never commit it.
# BACKUP_PASSPHRASE=change-me-to-a-long-random-string
